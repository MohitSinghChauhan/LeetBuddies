{
  "manifest_version": 3,
  "name": "LeetBuddies - Friends' LeetCode Stats Tracker",
  "version": "2.1",
  "description": "LeetBuddies: The ultimate tracker to compare LeetCode stats, heatmaps, and achievements with your friends.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode-stats-api-qgnk.onrender.com/*",
    "https://leetcard.jacoblin.cool/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
